  "defaults": {
    "accToApp": {
      "level": { "fl": 150, "trend": "descending" },
      "note": "Arrivees transferees a l'APP en descente FL150 sur STAR ou vers le dernier point FPL (§3.2.3)"
    },
    "appToAcc": {
      "level": { "fl": 140, "trend": "climbing" },
      "note": "Departs transferes en montee FL140 sur SID ou vers le premier point FPL (§3.2.3)"
    },
    "general": [
      "Le trafic est repute maintenir le niveau coordonne au COP sauf condition de montee/descente explicite (§3.1).",
      "Toute deviation (COP, route, FL) impose une approval request (§3.1).",
      "Silent handover possible a 10 NM, obligatoire si separation longitudinale < 20 NM (§3.1)."
    ]
  },

