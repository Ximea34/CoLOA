        { "when": { "arr": ["LIM*", "LSZ*"], "arrExcept": ["LIMJ"] }, "level": { "fl": 370 } },
        { "when": { "arr": ["LSGC", "LSGS", "LSGK", "LSMP", "LSGG", "LSGL", "LSGP", "LFLI", "LFHN"] },
